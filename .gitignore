# 说明：docs/ 是 GitHub Pages 的发布目录（仓库设置里 Source = 分支 main、目录 /docs），
# 因此构建产物要提交。改完 content/ 跑一次 python3 scripts/build.py 再推送即可。

# 采集运行时状态（本地跑采集时的临时产物）
content/collected/_state.json
content/collected/_anomalies.json

# Python 缓存
__pycache__/
*.pyc

# 本地预览与临时文件
.sites-runtime/
node_modules/
*.log
*.tar.gz

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
